From ca891c90c7385513719fc8405d252df280693b22 Mon Sep 17 00:00:00 2001
From: Abdullah Hanif <318923962+abdullahhanif-001@users.noreply.github.com>
Date: Fri, 23 Oct 2026 10:05:02 +0000
Subject: [PATCH] whisper: break trigram repetition loops during decode

---
 src/whisper.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/whisper.cpp b/src/whisper.cpp
index f138c38..860f65d 100644
--- a/src/whisper.cpp
+++ b/src/whisper.cpp
@@ -7611,6 +7611,24 @@ int whisper_full_with_state(
                         }
                     }
 
+                    {
+                        auto & tokens = decoder.sequence.tokens;
+                        if (tokens.size() >= 9) {
+                            bool trigram_repeat = true;
+                            for (int k = 0; k < 3 && trigram_repeat; k++) {
+                                if (tokens[tokens.size() - 1 - k].id != tokens[tokens.size() - 4 - k].id ||
+                                    tokens[tokens.size() - 1 - k].id != tokens[tokens.size() - 7 - k].id) {
+                                    trigram_repeat = false;
+                                }
+                            }
+                            if (trigram_repeat) {
+                                WHISPER_LOG_DEBUG("%s: decoder %d: trigram repetition detected, forcing EOT\n", __func__, j);
+                                completed = true;
+                                continue;
+                            }
+                        }
+                    }
+
                     // sometimes, the decoding can get stuck in a repetition loop
                     // this is an attempt to mitigate such cases - we flag the decoding as failed and use a fallback strategy
                     if (i == n_max - 1 && (result_len == 0 || seek_delta < 100*WHISPER_CHUNK_SIZE/2)) {
-- 
2.43.0

