From 6c1dbcc89ff56efd7926f437c49c307eaf25e19b Mon Sep 17 00:00:00 2001
From: Abdullah Hanif <318923962+abdullahhanif-001@users.noreply.github.com>
Date: Fri, 23 Oct 2026 10:04:55 +0000
Subject: [PATCH] whisper: reuse mel_pad_buf in log_mel_spectrogram for
 streaming

---
 src/whisper.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/whisper.cpp b/src/whisper.cpp
index e9e65f4..f138c38 100644
--- a/src/whisper.cpp
+++ b/src/whisper.cpp
@@ -946,6 +946,7 @@ struct whisper_state {
     std::vector<vad_time_mapping> vad_mapping_table;
 
     std::vector<float> short_pad_buf;
+    std::vector<float> mel_pad_buf;
 };
 
 struct whisper_context {
@@ -3260,9 +3261,11 @@ static bool log_mel_spectrogram(
     int64_t stage_1_pad = WHISPER_SAMPLE_RATE * 30;
     int64_t stage_2_pad = frame_size / 2;
 
-    // Initialize a vector and copy data from C array to it.
-    std::vector<float> samples_padded;
-    samples_padded.resize(n_samples + stage_1_pad + stage_2_pad * 2);
+    auto & samples_padded = wstate.mel_pad_buf;
+    const size_t needed = n_samples + stage_1_pad + stage_2_pad * 2;
+    if (samples_padded.size() < needed) {
+        samples_padded.resize(needed);
+    }
     std::copy(samples, samples + n_samples, samples_padded.begin() + stage_2_pad);
 
     // pad 30 seconds of zeros at the end of audio (480,000 samples) + reflective pad 200 samples at the end of audio
-- 
