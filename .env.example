# EchoVox Environment Variables
# Copy to .env and adjust for your deployment

# Install directory override (default: ~/EchoVox on Unix, %USERPROFILE%\EchoVox on Windows)
# ECHOVOX_DIR=/opt/echovox

# whisper-server port (VPS deployment)
# WHISPER_PORT=8080

# Model path (relative to repo root)
# WHISPER_MODEL=whisper.cpp/models/ggml-medium-urdu-q4_0.bin

# Language code for transcription
# WHISPER_LANG=ur

# Number of inference threads (1 recommended for 512MB VPS)
# WHISPER_THREADS=1

# Audit smoke mode (set in CI, not needed locally)
# MYTHOS_SMOKE=1
# ULTRA_SMOKE=1
